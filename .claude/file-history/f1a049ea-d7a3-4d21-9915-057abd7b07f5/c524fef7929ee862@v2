"""Foundation DL files sent to the LLM as context for query generation."""
from __future__ import annotations

from pathlib import Path

from src.pipeline.config import Paths


def foundation_files() -> list[Path]:
    """foundation-core.dle, ardoqvocab.dle, then every other foundation-*.dle."""
    extensions = sorted(
        p for p in Paths.dl.glob("foundation-*.dle") if p != Paths.foundation_core
    )
    return [Paths.foundation_core, Paths.ardoqvocab, *extensions]


def foundation_context() -> list[dict]:
    """One text block per foundation file."""
    return [
        {"type": "text", "text": f"=== {p.name} ===\n{p.read_text(encoding='utf-8')}"}
        for p in foundation_files()
    ]
